pipeline {

    agent any

    environment {

        DB_HOST = "localhost"

        DB_PORT = "5432"

        DB_NAME = "fincore"

        DB_USER = "admin"

        DB_PASSWORD = "fincore123"

        API_BASE_URL = "http://localhost:4000/api/v1"

        UI_BASE_URL = "http://localhost:3000"

        PYTHONUNBUFFERED = "1"

        PYTHON_EXE = "C:\\Users\\PradeepKumar5\\AppData\\Local\\Programs\\Python\\Python312\\python.exe"

        JAVA_HOME = "C:\\Users\\PradeepKumar5\\AppData\\Local\\Programs\\Eclipse Adoptium\\jdk-17.0.20.8-hotspot"
    }

    options {

        timestamps()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20'
            )
        )
    }

    stages {

        stage('Checkout') {

            steps {

                echo "Checking out source code"

                checkout scm
            }
        }

        stage('Environment Check') {

            steps {

                bat '''
                    echo ===== VERIFY JAVA =====
                    set JAVA_HOME=C:\\Users\\PradeepKumar5\\AppData\\Local\\Programs\\Eclipse Adoptium\\jdk-17.0.20.8-hotspot

                    "%JAVA_HOME%\\bin\\java.exe" -version

                    if errorlevel 1 (
                        echo Java validation failed
                        exit /b 1)
                    
                    echo ===== VERIFY PYTHON =====

                    if not exist "%PYTHON_EXE%" (
                        echo Python was not found or is not accessible to the Jenkins service account:
                        echo %PYTHON_EXE%
                        exit /b 1
                    )

                    "%PYTHON_EXE%" --version
                    "%PYTHON_EXE%" -m venv .venv
                    .venv\\Scripts\\python.exe -m pip install --upgrade pip
                    .venv\\Scripts\\python.exe -m pip install -r pipeline\\requirements.txt -r tests\\requirements.txt -r data\\requirements.txt
                    .venv\\Scripts\\python.exe -m playwright install chromium
                    .venv\\Scripts\\python.exe -m pytest --version
                '''
            }
        }

        stage('Generate Data') {

            steps {

                bat '''
                    .venv\\Scripts\\python.exe data\\generate_data.py
                '''
            }
        }

        stage('Load Data') {

            steps {

                bat '''
                    set JAVA_HOME=C:\\Users\\PradeepKumar5\\AppData\\Local\\Programs\\Eclipse Adoptium\\jdk-17.0.20.8-hotspot

                    set PATH=%JAVA_HOME%\\bin;%PATH%

                    echo ===== CURRENT WORKSPACE =====
                    echo %WORKSPACE%

                    echo ===== VERIFY DATA FOLDER =====
                    dir data

                    echo ===== VERIFY GOOD DATA =====
                    dir data\\good_data

                    echo ===== SEARCH ALL CSV FILES =====
                    dir /s *.csv

                    java -version

                    .venv\\Scripts\\python.exe pipeline\\ingest.py good_data
                '''
            }
        }

        stage('DQ Validation (UC1)') {

            steps {

                bat '''
                    .venv\\Scripts\\python.exe tests\\dq\\great_expectations\\gx\\run_gx.py
                '''
            }
        }

        stage('API Tests (UC2)') {

            steps {

                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'FAILURE'
                ) {

                    bat '''
                        .venv\\Scripts\\python.exe -m pytest tests\\api ^
                        --html=tests\\reports\\api_report.html ^
                        --self-contained-html
                    '''
                }
            }
        }

        stage('UI Tests (UC3)') {

            steps {

                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'FAILURE'
                ) {

                    bat '''
                        .venv\\Scripts\\python.exe -m pytest tests\\ui ^
                        --html=tests\\reports\\ui_report.html ^
                        --self-contained-html
                    '''
                }
            }
        }

        stage('Pipeline Tests (UC4)') {

            steps {

                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'FAILURE'
                ) {

                    bat '''
                        .venv\\Scripts\\python.exe -m pytest tests\\pipeline ^
                        --html=tests\\reports\\pipeline_report.html ^
                        --self-contained-html
                    '''
                }
            }
        }

        stage('Archive Reports') {

            steps {

                archiveArtifacts(
                    artifacts:
                    '''
                    tests/reports/**/*.html,
                    tests/reports/**/*.png,
                    tests/dq/great_expectations/gx/uncommitted/data_docs/**
                    ''',
                    allowEmptyArchive: true
                )
            }
        }

        stage('Notify') {

            steps {

                echo "Build Result: ${currentBuild.currentResult}"
            }
        }
    }

    post {

        always {

            echo 'Pipeline execution completed.'
        }

        success {

            echo 'All validations passed.'
        }

        failure {

            echo 'Pipeline FAILED.'

            script {
                try {
                    mail(
                        to: 'pradeep_kumar5@epam.com',
                        subject: "FinCore Pipeline Failure - Build ${BUILD_NUMBER}",
                        body: """
                        Build URL:
                        ${BUILD_URL}

                        Pipeline failed.

                        Please review reports and logs.
                        """
                    )
                } catch (Exception exception) {
                    echo "Failure email was not sent: ${exception.message}"
                }
            }
        }
    }
}
