pipeline {

    agent any

    environment {

        DB_HOST = "localhost"

        DB_PORT = "5432"

        DB_NAME = "fincore"

        DB_USER = "admin"

        DB_PASSWORD = "fincore123"

        API_BASE_URL = "http://localhost:4000/api/v1"

        UI_BASE_URL = "http://localhost:3000"

        PYTHONUNBUFFERED = "1"

        PYTHON_EXE = "C:\\Users\\PradeepKumar5\\AppData\\Local\\Programs\\Python\\Python312\\python.exe"

        JAVA_HOME = "C:\\Users\\PradeepKumar5\\AppData\\Local\\Programs\\Eclipse Adoptium\\jdk-17.0.20.8-hotspot"
    }

    options {

        timestamps()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20'
            )
        )
    }

    stages {

        stage('Checkout') {

            steps {

                echo "Checking out source code"

                checkout scm
            }
        }

        stage('Environment Check') {

            steps {

                bat '''
                    echo ===== VERIFY JAVA =====

                    "%JAVA_HOME%\\bin\\java.exe" -version

                    if errorlevel 1 (
                        echo Java validation failed
                        exit /b 1)
                    
                    echo ===== VERIFY PYTHON =====

                    "%PYTHON_EXE%" --version

                    "%PYTHON_EXE%" -m venv .venv

                    .venv\\Scripts\\python.exe -m pip install --upgrade pip

                    .venv\\Scripts\\python.exe ^
                    -m pip install ^
                    -r pipeline\\requirements.txt ^
                    -r tests\\requirements.txt ^
                    -r data\\requirements.txt

                    .venv\\Scripts\\python.exe ^
                    -m playwright install chromium

                    .venv\\Scripts\\python.exe ^
                    -m pytest --version
                '''
            }
        }

        stage('Generate Data') {

            steps {

                bat '''
                    .venv\\Scripts\\python.exe data\\generate_data.py
                '''
            }
        }

        stage('Load Data') {

            steps {

                bat '''

                    set PATH=%JAVA_HOME%\\bin;%PATH%

                    set "PYSPARK_PYTHON=%WORKSPACE%\\.venv\\Scripts\\python.exe"

                    set "PYSPARK_DRIVER_PYTHON=%WORKSPACE%\\.venv\\Scripts\\python.exe"

                    if not exist "%WORKSPACE%\\spark-temp" mkdir "%WORKSPACE%\\spark-temp"

                    set "SPARK_LOCAL_DIRS=%WORKSPACE%\\spark-temp"

                    java -version

                    .venv\\Scripts\\python.exe pipeline\\ingest.py good_data
                '''
            }
        }

        stage('DQ Validation (UC1)') {

            steps {

                bat '''

                    set FINCORE_CONN=postgresql+psycopg2://%DB_USER%:%DB_PASSWORD%@%DB_HOST%:%DB_PORT%/%DB_NAME%

                    echo FINCORE_CONN configured

                    .venv\\Scripts\\python.exe tests\\dq\\great_expectations\\gx\\run_gx.py
                '''
            }
        }

        stage('API Tests (UC2)') {

            steps {

                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'FAILURE'
                ) {

                    bat '''
                        .venv\\Scripts\\python.exe -m pytest tests\\api ^
                        --html=tests\\reports\\api_report.html ^
                        --self-contained-html
                    '''
                }
            }
        }

        stage('UI Tests (UC3)') {

            steps {

                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'FAILURE'
                ) {

                    bat '''
                        .venv\\Scripts\\python.exe -m pytest tests\\ui ^

                        --html=tests\\reports\\ui_report.html ^
                        --self-contained-html
                    '''
                }
            }
        }

        stage('Pipeline Tests (UC4A)') {

            steps {

                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'FAILURE'
                ) {

                    bat '''
                        set "PATH=%JAVA_HOME%\\bin;%PATH%"

                        set "PYSPARK_PYTHON=%WORKSPACE%\\.venv\\Scripts\\python.exe"
                        set "PYSPARK_DRIVER_PYTHON=%WORKSPACE%\\.venv\\Scripts\\python.exe"

                        if not exist "%WORKSPACE%\\spark-temp" mkdir "%WORKSPACE%\\spark-temp"

                        set "SPARK_LOCAL_DIRS=%WORKSPACE%\\spark-temp"


                        .venv\\Scripts\\python.exe 
                        -m pytest tests\\pipeline\\test_transformations.py ^
                        --html=tests\\reports\\pipeline_unit_report.html ^
                        --self-contained-html
                    '''
                }
            }
        }


        stage('Pipeline E2E Tests (UC4C)') {

            steps {

                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'FAILURE'
                ) {

                    bat '''
                        set "PATH=%JAVA_HOME%\\bin;%PATH%"

                        set "PYSPARK_PYTHON=%WORKSPACE%\\.venv\\Scripts\\python.exe"
                        set "PYSPARK_DRIVER_PYTHON=%WORKSPACE%\\.venv\\Scripts\\python.exe"

                        if not exist "%WORKSPACE%\\spark-temp" mkdir "%WORKSPACE%\\spark-temp"

                        set "SPARK_LOCAL_DIRS=%WORKSPACE%\\spark-temp"

                        .venv\\Scripts\\python.exe ^
                        -m pytest tests\\pipeline\\test_E_to_E.py ^
                        --html=tests\\reports\\pipeline_e2e_report.html ^
                        --self-contained-html
                    '''
                }
            }
        }

        stage('Notify') {

            steps {

                echo "Build Result: ${currentBuild.currentResult}"
            }
        }
    }

        post {
        always {
            echo 'Pipeline execution completed.'

            archiveArtifacts(
                artifacts: '''
                    tests/reports/**/*.html,
                    tests/reports/**/*.png,
                    tests/reports/**/*.zip,
                    tests/reports/screenshots/**/*,
                    tests/dq/great_expectations/gx/uncommitted/data_docs/**
                ''',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'All validations passed.'
        }

        unstable {
            echo 'One or more validation stages failed.'
        }

        failure {
            echo 'Pipeline FAILED.'

            script {
                try {
                    mail(
                        to: 'pradeep_kumar5@epam.com',
                        subject: "FinCore Pipeline Failure - Build ${BUILD_NUMBER}",
                        body: """
                            Build URL: ${BUILD_URL}
                            Pipeline failed.
                            Please review archived reports.
                        """
                    )
                } catch (Exception exception) {
                    echo "Failure email was not sent: ${exception.message}"
                }
            }
        }
    }
}